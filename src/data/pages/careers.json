     "t": "Work where you do your best thinking. Come together in-office for high-signal collaboration, team offsites and company-wide sessions.",
     "fs": 14,
     "c": "rgb(40, 3, 15)"
    },
    {
     "k": "h",
     "lvl": 3,
     "t": "IVF & fertility support",
     "fs": 24,
     "ff": "exposure",
     "ta": "start"
    },
    {
     "k": "p",
     "t": "A one-time direct payment to support employees through IVF, egg freezing or sperm freezing, recognising the personal and financial weight of the journey.",
