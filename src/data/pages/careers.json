    {
     "k": "p",
     "t": "Paid parental leave at full salary: 26 weeks for primary carers and 18 weeks for secondary carers, globally. Your equity continues to vest throughout.",
     "fs": 14,
     "c": "rgb(40, 3, 15)"
    },
    {
     "k": "h",
