   "blocks": [
    {
     "k": "p",
     "t": "We chose a purpose-driven mission that actually matters, and we hire people who want to do the same. You’ll be pushed to do your very best work, but you will trust, admire, and learn from the people working right alongside you. And if we’re honest, it’s not easy. Standard tech playbooks routinely fail in healthcare, and the friction of the medical system will test your perseverance. If you want to do your life’s best work at the edge of healthcare, tech and invention, this is the place to do it.",
     "fs": 16,
     "c": "rgb(40, 3, 15)"
    }
