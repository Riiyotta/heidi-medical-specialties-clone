 "tabs": [
  {
   "label": "Stop losing providers to burnout",
   "body": "Heidi adapts to how providers actually work, they speak naturally during care, get structured clinical notes instantly, with zero cleanup after. When tools help instead of adding steps, top talent stays focused on patients, not admin tasks.",
   "img": "/assets/bands/enterprise/tabs-0.png"
  },
  {
   "label": "Turn documentation time into patient time",
   "body": "Every minute spent on notes is a minute not spent with patients. Heidi handles real-time transcription, documentation, coding, and follow-up tasks while providers stay fully present during encounters. More throughput without hiring more staff.",
   "img": "/assets/bands/enterprise/tabs-1.png"
  },
  {
   "label": "Scale one platform across each department",
   "body": "From emergency to psychiatry, pediatrics to oncology: Heidi understands clinical language across specialties. Your providers move seamlessly between departments without learning new systems or losing momentum.",
   "img": "/assets/bands/enterprise/tabs-2.png"
  }
 ]
}